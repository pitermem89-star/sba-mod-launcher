{
  "id": "plane-skin",
  "name": "Plane Skin",
  "version": "1.0.0",
  "author": "spikle",
  "library": "libplane_skin.so",
  "settings": [
    { "key": "enabled", "label": "Включено", "type": "bool", "default": true },
    { "key": "scale", "label": "Масштаб", "type": "float", "min": 0.05, "max": 10, "step": 0.05, "default": 1 },
    { "key": "yaw", "label": "Поворот Y", "type": "int", "min": -180, "max": 180, "step": 15, "default": 0 },
    { "key": "pitch", "label": "Поворот X", "type": "int", "min": -180, "max": 180, "step": 15, "default": 0 },
    { "key": "roll", "label": "Поворот Z", "type": "int", "min": -180, "max": 180, "step": 15, "default": 0 },
    { "key": "offset_y", "label": "Смещение вверх", "type": "float", "min": -5, "max": 5, "step": 0.1, "default": 0 }
  ]
}
